# Template only — placeholders, safe to commit. Copy to .env and add real keys.
# NEVER put real secrets in this file. Real secrets go in .env (gitignored).

APP_NAME=verifyKYB API
ENVIRONMENT=dev

# --- Database ---
# SQLite (default, zero setup):
DATABASE_URL=sqlite:///./verifykyb.db
# Postgres example:
# DATABASE_URL=postgresql+psycopg://verifykyb:verifykyb@localhost:5432/verifykyb

# --- Registry provider: mock | companies_house | us_sos ---
REGISTRY_PROVIDER=mock
DEFAULT_JURISDICTION=us

# --- US Secretary of State (Apify) ---
APIFY_API_TOKEN=apify_api_xxxxxxxxxxxxxxxxxxxxx
APIFY_US_SOS_ACTOR=clearpath/us-business-entity-search

# --- UK Companies House (free key) ---
# https://developer.company-information.service.gov.uk/
COMPANIES_HOUSE_API_KEY=
COMPANIES_HOUSE_BASE_URL=https://api.company-information.service.gov.uk

# --- Decision thresholds (0..1) ---
AUTO_APPROVE_THRESHOLD=0.85
MANUAL_REVIEW_THRESHOLD=0.50
NAME_MATCH_THRESHOLD=0.80
ADDRESS_MATCH_THRESHOLD=0.60

# --- Feature 2: digital footprint ---
# Crawler: mock | static (free) | apify | tiered (static -> apify fallback)
CRAWLER_PROVIDER=mock
DOMAIN_AGE_RED_FLAG_DAYS=90
# Summarizer: template (no LLM) | openrouter
SUMMARIZER_PROVIDER=template
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
# urlscan.io reputation/screenshot enrichment (optional)
URLSCAN_API_KEY=

# --- Feature 3: risk engine + vector store / memory ---
ENABLE_VECTOR=true
CHROMA_PATH=./chroma_store

# --- Feature 4: web-intelligence agent (registry fallback / on-demand) ---
ENABLE_ENRICHMENT=true
# Web search provider: ddg (free, no key) | crawl4ai | apify
SEARCH_PROVIDER=ddg
# Crawl4AI cloud (optional; free 1,000 credits/mo). Open-source scraping needs
# no key — just: pip install crawl4ai && crawl4ai-setup
CRAWL4AI_API_KEY=
CRAWL4AI_BASE_URL=https://api.crawl4ai.com
APIFY_SERP_ACTOR=apify/google-search-scraper
ENRICHMENT_MAX_QUERIES=6
ENRICHMENT_MAX_PAGES=5
ENRICHMENT_CHAR_CAP=12000
# LLM-as-judge (complementary web-presence score; never decides)
JUDGE_MODEL=
JUDGE_MAX_ADJUST=15
# Extra registry attempts on a transient failure
REGISTRY_RETRY=1
